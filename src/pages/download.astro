---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
import { seo } from "../lib/seo";
import { APP_URL, GITHUB_REPO, GITHUB_RELEASES } from "../config/site";
---

<Layout
  {...seo({
    title: "Download Quran Studio for Windows — Free",
    description:
      "Download Quran Studio for Windows. Free, open-source Quran recitation video editor. No account needed.",
    path: "/download",
  })}
>
  <Nav />
  <main>
    <Download />
    <section class="section">
      <div class="container">
        <h2 class="section-title">System Requirements</h2>
        <div class="req-tabs" role="tablist" aria-label="System requirements by OS">
          <button class="req-tab active" data-os="windows" role="tab" aria-selected="true">🪟 Windows</button>
          <button class="req-tab" data-os="macos" role="tab" aria-selected="false">🍎 macOS</button>
          <button class="req-tab" data-os="linux" role="tab" aria-selected="false">🐧 Linux</button>
        </div>
        <div class="req-panels">
          <div class="req-panel active" data-os="windows" role="tabpanel">
            <div class="req-grid">
              <div class="req-card">
                <h3>🖥️ OS</h3>
                <p>Windows 10 / 11 (64-bit)</p>
              </div>
              <div class="req-card">
                <h3>💾 Disk</h3>
                <p>~200 MB free space</p>
              </div>
              <div class="req-card">
                <h3>🌐 Internet</h3>
                <p>Needed for reciter audio &amp; updates</p>
              </div>
            </div>
          </div>
          <div class="req-panel" data-os="macos" role="tabpanel">
            <div class="req-grid">
              <div class="req-card">
                <h3>🖥️ OS</h3>
                <p>macOS 11 Big Sur or later (Apple Silicon &amp; Intel)</p>
              </div>
              <div class="req-card">
                <h3>💾 Disk</h3>
                <p>~200 MB free space</p>
              </div>
              <div class="req-card">
                <h3>🌐 Internet</h3>
                <p>Needed for reciter audio &amp; updates</p>
              </div>
            </div>
            <p class="req-note">
              ⚠️ The app is not notarized by Apple — on first launch, right-click
              the app and choose <strong>Open</strong> to run it.
            </p>
          </div>
          <div class="req-panel" data-os="linux" role="tabpanel">
            <div class="req-grid">
              <div class="req-card">
                <h3>🖥️ OS</h3>
                <p>Ubuntu 20.04+ / Fedora / Debian (64-bit)</p>
              </div>
              <div class="req-card">
                <h3>💾 Disk</h3>
                <p>~200 MB free space</p>
              </div>
              <div class="req-card">
                <h3>🌐 Internet</h3>
                <p>Needed for reciter audio &amp; updates</p>
              </div>
            </div>
            <p class="req-note">
              💡 For the AppImage: make it executable
              (<code>chmod +x</code>) or install FUSE to run it.
            </p>
          </div>
        </div>
        <script>
          (function () {
            var tabs = document.querySelectorAll(".req-tab");
            var panels = document.querySelectorAll(".req-panel");
            function selectOs(os) {
              tabs.forEach(function (t) {
                var active = t.dataset.os === os;
                t.classList.toggle("active", active);
                t.setAttribute("aria-selected", String(active));
              });
              panels.forEach(function (p) {
                p.classList.toggle("active", p.dataset.os === os);
              });
            }
            tabs.forEach(function (t) {
              t.addEventListener("click", function () {
                selectOs(t.dataset.os || "windows");
              });
            });
            // Pre-select the visitor's OS
            var ua = navigator.userAgent;
            if (/Mac/i.test(ua)) selectOs("macos");
            else if (/Linux/i.test(ua)) selectOs("linux");
            else selectOs("windows");
          })();
        </script>
        <h2 class="section-title" style="margin-top: 4rem">Other Ways to Get It</h2>
        <p class="section-sub">
          Prefer the browser? A web version is available too — no install needed.
        </p>
        <div class="alt-list">
          <a
            href={APP_URL}
            target="_blank"
            rel="noopener"
            class="btn btn-primary btn-lg"
          >
            🌐 Open Web App
          </a>
          <a
            href={GITHUB_RELEASES}
            target="_blank"
            rel="noopener"
            class="btn btn-ghost"
          >
            All Releases on GitHub
          </a>
          <a
            href={GITHUB_REPO}
            target="_blank"
            rel="noopener"
            class="btn btn-ghost"
          >
            Source Code
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
