---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
import { seo } from "../lib/seo";
import { SITE_NAME, APP_URL, GITHUB_REPO, GITHUB_RELEASES } from "../config/site";
---

<Layout
  {...seo({
    title: "Download " + SITE_NAME + " for Windows, macOS & Linux — Free",
    description:"Download " + SITE_NAME + " for Windows, macOS, or Linux. Free, open-source Quran recitation video editor. No account needed.",
    path: "/download",
  })}
>
  <Nav />
  <main>
    <h1 class="sr-only">Download Quran Studio for Windows, macOS & Linux — Free</h1>
    <Download />
    <section class="section req-section">
      <div class="container">
        <h2 class="section-title">System Requirements</h2>
        <div class="req-tabs" role="tablist" aria-label="System requirements by OS">
          <button class="req-tab active" id="req-tab-windows" data-os="windows" role="tab" aria-selected="true" aria-controls="req-panel-windows">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5l8-1.1v7.6H3zM12 4.2L21 3v9H12zM3 12h8v7.6l-8-1.1zM12 12h9v9l-9-1.2z"/></svg>
            Windows
          </button>
          <button class="req-tab" id="req-tab-macos" data-os="macos" role="tab" aria-selected="false" aria-controls="req-panel-macos">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.28l-.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
            macOS
          </button>
          <button class="req-tab" id="req-tab-linux" data-os="linux" role="tab" aria-selected="false" aria-controls="req-panel-linux">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C7.6 2 4.5 5.8 4.5 10.5c0 2.9 1.5 5.5 3.7 7-.2.3-.3.7-.3 1.1 0 .8.7 1.5 1.5 1.5h5.2c.8 0 1.5-.7 1.5-1.5 0-.4-.1-.8-.3-1.1 2.2-1.5 3.7-4.1 3.7-7C19.5 5.8 16.4 2 12 2zM9.5 8.5c.8 0 1.5.7 1.5 1.5s-.7 1.5-1.5 1.5S8 10.8 8 10s.7-1.5 1.5-1.5zm5 0c.8 0 1.5.7 1.5 1.5s-.7 1.5-1.5 1.5-1.5-.7-1.5-1.5.7-1.5 1.5-1.5zM12 13l-1.8 2.4h3.6L12 13z"/></svg>
            Linux
          </button>
        </div>
        <div class="req-panels">
          <div class="req-panel active" id="req-panel-windows" data-os="windows" role="tabpanel" aria-labelledby="req-tab-windows">
            <div class="req-grid">
              <div class="req-card">
                <h3>🖥️ OS</h3>
                <p>Windows 10 / 11 (64-bit)</p>
              </div>
              <div class="req-card">
                <h3>💾 Disk</h3>
                <p>~200 MB free space</p>
              </div>
              <div class="req-card">
                <h3>🌐 Internet</h3>
                <p>Needed for reciter audio &amp; updates</p>
              </div>
            </div>
          </div>
          <div class="req-panel" id="req-panel-macos" data-os="macos" role="tabpanel" aria-labelledby="req-tab-macos">
            <div class="req-grid">
              <div class="req-card">
                <h3>🖥️ OS</h3>
                <p>macOS 11 Big Sur or later (Apple Silicon &amp; Intel)</p>
              </div>
              <div class="req-card">
                <h3>💾 Disk</h3>
                <p>~200 MB free space</p>
              </div>
              <div class="req-card">
                <h3>🌐 Internet</h3>
                <p>Needed for reciter audio &amp; updates</p>
              </div>
            </div>
            <p class="req-note">⚠️ The app is not notarized by Apple — on first launch, right-click the app and choose <strong>Open</strong> to run it.</p>
          </div>
          <div class="req-panel" id="req-panel-linux" data-os="linux" role="tabpanel" aria-labelledby="req-tab-linux">
            <div class="req-grid">
              <div class="req-card">
                <h3>🖥️ OS</h3>
                <p>Ubuntu 20.04+ / Fedora / Debian (64-bit)</p>
              </div>
              <div class="req-card">
                <h3>💾 Disk</h3>
                <p>~200 MB free space</p>
              </div>
              <div class="req-card">
                <h3>🌐 Internet</h3>
                <p>Needed for reciter audio &amp; updates</p>
              </div>
            </div>
            <p class="req-note">💡 For the AppImage: make it executable (<code>chmod +x</code>) or install FUSE to run it.</p>
          </div>
        </div>
        <script>
          (function () {
            var tabs = document.querySelectorAll(".req-tab");
            var panels = document.querySelectorAll(".req-panel");
            function selectOs(os) {
              tabs.forEach(function (t) {
                var active = t.dataset.os === os;
                t.classList.toggle("active", active);
                t.setAttribute("aria-selected", String(active));
              });
              panels.forEach(function (p) {
                p.classList.toggle("active", p.dataset.os === os);
              });
            }
            tabs.forEach(function (t) {
              t.addEventListener("click", function () {
                selectOs(t.dataset.os || "windows");
              });
            });
            // Pre-select the visitor's OS
            var ua = navigator.userAgent;
            if (/Mac/i.test(ua)) selectOs("macos");
            else if (/Linux/i.test(ua)) selectOs("linux");
            else selectOs("windows");
          })();
        </script>
        <h2 class="section-title" style="margin-top: 4rem">Other Ways to Get It</h2>
        <p class="section-sub">Prefer the browser? A web version is available too — no install needed.</p>
        <div class="alt-list">
          <a href={APP_URL} target="_blank" rel="noopener" class="btn btn-primary btn-lg">🌐 Open Web App</a>
          <a href={GITHUB_RELEASES} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">All Releases on GitHub</a>
          <a href={GITHUB_REPO} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>Star on GitHub</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
