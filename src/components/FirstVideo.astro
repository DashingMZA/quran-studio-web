---
const days = [
  {
    d: "Minute 1",
    title: "Download & open",
    text: "Install the app on Windows and launch it. No account, no sign-up.",
  },
  {
    d: "Minute 2",
    title: "Pick a surah",
    text: "Choose any surah and verse range — try Ayat-ul-Kursi for your first video.",
  },
  {
    d: "Minute 5",
    title: "Style it",
    text: "Pick a reciter, a font and a background. Watch the preview update live.",
  },
  {
    d: "Minute 10",
    title: "Export & upload",
    text: "Render your HD video and share it on YouTube, TikTok or WhatsApp.",
  },
];
---

<section class="section first">
  <div class="container">
    <p class="kicker">Your first video</p>
    <h2 class="section-title">From download to your first upload in 10 minutes</h2>
    <div class="timeline">
      {days.map((s) => (
        <div class="t-item">
          <div class="t-day">{s.d}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>