---
import {SITE_URL, SITE_NAME, APP_URL, AUTHOR_NAME, AUTHOR_GITHUB, GITHUB_REPO, GITHUB_RELEASES, SOCIALS, SOCIAL_IMAGE, DEFAULT_SEO,} from "../config/site";

const websiteId = `${SITE_URL}/#website`;
const softwareId = `${SITE_URL}/#software`;
const publisherId = `${SITE_URL}/#publisher`;

// Social profiles from site.ts (empty URLs filtered out) — used for Person sameAs.
const socialUrls = SOCIALS.map((s) => s.url).filter((u) => u);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: SITE_NAME,
      url: SITE_URL,
      description: DEFAULT_SEO.description,
      inLanguage: "en",
      publisher: {
        "@id": publisherId,
      },
      about: {
        "@id": softwareId,
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": softwareId,
      name: SITE_NAME,
      url: SITE_URL,
      description: "Create Quran recitation videos with customizable verse styling, reciter audio, and video export.",
      applicationCategory: "MultimediaApplication",
      // Desktop app ships for all three (see /download), plus the web app.
      operatingSystem: ["Windows", "macOS", "Linux"],
      isAccessibleForFree: true,
      downloadUrl: GITHUB_RELEASES,
      featureList: [
        "Quran recitation videos with reciter audio",
        "Word-by-word verse highlighting synced to recitation",
        "Verse styling, fonts and backgrounds",
        "Translations alongside the Arabic text",
        "HD MP4 export for YouTube, Instagram Reels and TikTok",
      ],
      sameAs: socialUrls,
      offers: {
        "@type": "Offer",
        price: 0,
        priceCurrency: "USD",
        url: APP_URL,
      },
      author: {
        "@id": publisherId,
      },
      ...(GITHUB_REPO
        ? { codeRepository: GITHUB_REPO }
        : {}),
      ...(SOCIAL_IMAGE
        ? { image: SOCIAL_IMAGE }
        : {}),
    },
    {
      "@type": "Person",
      "@id": publisherId,
      name: AUTHOR_NAME,
      url: AUTHOR_GITHUB,
      sameAs: [...new Set([AUTHOR_GITHUB, ...socialUrls])],
    },
  ],
};

---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
/>
