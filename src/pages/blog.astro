---
import { SITE_NAME } from "../config/site";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { seo } from "../lib/seo";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  {...seo({
    title: "Blog — " + SITE_NAME + " | Quran Video Guides & Tips",
    description:
      "Guides and tips for creating beautiful Quran recitation videos: YouTube, Reels, fonts, backgrounds, translations and more.",
    path: "/blog",
  })}
>
  <Nav />
  <main>
    <section class="section">
      <div class="container">
        <h1 class="section-title">Blog</h1>
        <p class="section-sub">
          Guides and tips for creating beautiful Quran recitation videos.
        </p>
        <div class="blog-list">
          {
            posts.map((post) => (
              <a href={"/blog/" + post.id} class="blog-card">
                {post.data.heroImage && (
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    class="blog-card-img"
                    loading="lazy"
                  />
                )}
                <div class="blog-card-body">
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <span class="blog-card-date">
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
