---
import { APP_URL } from "../config/seo";
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="version-badge">
      <span class="dot"></span>
      v1.0.1
    </div>
    <h1 class="hero-title">
      <span class="brand-quran">Quran</span> <span class="brand-studio">Studio</span>
    </h1>
    <p class="hero-tag">
      Create beautiful Quran recitation videos in minutes.<br />
      Pick a reciter, style the verses, export in HD — free forever.
    </p>
    <div class="hero-cta">
      <a href="#download" class="btn btn-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Download for Windows
      </a>
      <a
        href="https://github.com/DashingMZA/quran-studio"
        target="_blank"
        rel="noopener"
        class="btn btn-ghost"
      >
        View on GitHub
      </a>
      <a
        href={APP_URL}
        target="_blank"
        rel="noopener"
        class="btn btn-ghost"
      >
        🌐 Open Web App
      </a>
    </div>
    <p class="hero-note">Open source &amp; free forever &bull; No account needed</p>
  </div>
</section>