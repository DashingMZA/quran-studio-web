---
// Cookie consent banner (GDPR-style). Only renders when GA_ID is configured.
// - No choice yet  -> banner with Accept / Decline
// - Accepted       -> loads GA4 silently (and AdSense, but only when
//                     ADSENSE_REQUIRE_CONSENT is true in site.ts — the
//                     loader in Layout.astro listens for the
//                     "qs:consent-accepted" event fired below)
// - Declined       -> GA (and gated AdSense) never loads
import { GA_ID, ADSENSE_REQUIRE_CONSENT } from "../config/site";
---

{GA_ID && (
  <>
    <div id="qs-consent" class="consent" hidden>
      <p>
        {ADSENSE_REQUIRE_CONSENT
          ? "We use cookies for analytics (Google Analytics) and ads (Google AdSense)."
          : "We use cookies to understand how this site is used (Google Analytics)."}
        You can accept or decline — the site works the same either way.
        <a href="/privacy-policy">Privacy Policy</a>
      </p>
      <div class="consent-btns">
        <button id="qs-consent-accept" class="btn btn-primary" type="button">Accept</button>
        <button id="qs-consent-decline" class="btn btn-ghost" type="button">Decline</button>
      </div>
    </div>
    <script define:vars={{ GA_ID }}>
      (function () {
        var KEY = "qs-consent";
        var banner = document.getElementById("qs-consent");
        if (!banner) return;

        function loadGA() {
          if (window.gtag) return;
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag("js", new Date());
          gtag("config", GA_ID);
        }

        var choice = null;
        try { choice = localStorage.getItem(KEY); } catch (e) {}

        if (choice === "accepted") {
          loadGA();
        } else if (choice !== "declined") {
          banner.hidden = false;
        }

        function decide(value) {
          try { localStorage.setItem(KEY, value); } catch (e) {}
          banner.hidden = true;
          if (value === "accepted") {
            loadGA();
            // Let Layout.astro's AdSense loader (gated mode only) know.
            window.dispatchEvent(new CustomEvent("qs:consent-accepted"));
          }
        }

        document.getElementById("qs-consent-accept").addEventListener("click", function () { decide("accepted"); });
        document.getElementById("qs-consent-decline").addEventListener("click", function () { decide("declined"); });
      })();
    </script>
  </>
)}