---
import {
  SITE_URL,
  SITE_NAME,
  APP_URL,
  AUTHOR_NAME,
  AUTHOR_GITHUB,
  GITHUB_REPO,
  SOCIAL_IMAGE,
} from "../config/site";

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: SITE_URL,
  description: `${SITE_NAME} is a free, open-source app to create beautiful Quran recitation videos. Pick a reciter, style the verses, export in HD.`,
  author: {
    "@type": "Person",
    name: AUTHOR_NAME,
    url: AUTHOR_GITHUB,
  },
};

const software = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_NAME,
  url: SITE_URL,
  applicationCategory: "MultimediaApplication",
  operatingSystem: ["Windows", "macOS", "Linux"],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  author: {
    "@type": "Person",
    name: AUTHOR_NAME,
    url: AUTHOR_GITHUB,
  },
  codeRepository: GITHUB_REPO,
  ...(SOCIAL_IMAGE ? { image: SOCIAL_IMAGE } : {}),
};

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/icons/quran-studio-logo.svg`,
  sameAs: [GITHUB_REPO, APP_URL],
};
---

<script type="application/ld+json" set:html={JSON.stringify(website)} />
<script type="application/ld+json" set:html={JSON.stringify(software)} />
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
