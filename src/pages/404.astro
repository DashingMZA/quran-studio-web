---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { seo } from "../lib/seo";
---

<Layout
  {...seo({
    title: "Page Not Found (404) — Quran Studio",
    description: "The page you're looking for doesn't exist. Find your way back to Quran Studio.",
    path: "/404",
  })}
>
  <Nav />
  <main>
    <section class="section">
      <div class="container" style="text-align: center; max-width: 560px;">
        <div style="font-size: 5rem; font-weight: 800; color: var(--green);">404</div>
        <h1 class="section-title">Page not found</h1>
        <p class="section-sub">
          The page you're looking for doesn't exist or was moved.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 2rem;">
          <a href="/" class="btn btn-primary">← Back to Home</a>
          <a href="/download" class="btn btn-ghost">Download App</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
