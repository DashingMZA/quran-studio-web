---
import {SITE_URL, SITE_NAME, APP_URL, AUTHOR_NAME, AUTHOR_GITHUB, GITHUB_REPO, SOCIAL_IMAGE,} from "../config/site";

const websiteId = `${SITE_URL}/#website`;
const softwareId = `${SITE_URL}/#software`;
const publisherId = `${SITE_URL}/#publisher`;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: SITE_NAME,
      url: SITE_URL,
      description: SITE_NAME + " is a free, open-source app to create beautiful Quran recitation videos. Pick a reciter, style the verses, export in HD.",
      inLanguage: "en",
      publisher: {
        "@id": publisherId,
      },
      about: {
        "@id": softwareId,
      },
    },
    {
      "@type": "SoftwareApplication",
      "@id": softwareId,
      name: SITE_NAME,
      url: SITE_URL,
      description: "Create Quran recitation videos with customizable verse styling, reciter audio, and video export.",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Windows",
      isAccessibleForFree: true,
      offers: {
        "@type": "Offer",
        price: 0,
        priceCurrency: "USD",
        url: APP_URL,
      },
      author: {
        "@id": publisherId,
      },
      ...(GITHUB_REPO
        ? { codeRepository: GITHUB_REPO }
        : {}),
      ...(SOCIAL_IMAGE
        ? { image: SOCIAL_IMAGE }
        : {}),
    },
    {
      "@type": "Person",
      "@id": publisherId,
      name: AUTHOR_NAME,
      url: AUTHOR_GITHUB,
      sameAs: [AUTHOR_GITHUB],
    },
  ],
};

---

<script
  type="application/ld+json"
  set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
/>
