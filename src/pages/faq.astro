---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { seo } from "../lib/seo";

const faqs = [
  {
    q: "Is Quran Studio really free?",
    a: "Yes — completely free, forever. It's open source under the GPL-3.0 license. No accounts, no watermarks, no subscriptions, no locked features.",
  },
  {
    q: "Which Windows versions are supported?",
    a: "Windows 10 and Windows 11 (64-bit). Download the installer from the Download page and you're ready in minutes.",
  },
  {
    q: "Why does Windows SmartScreen warn me during install?",
    a: "SmartScreen flags new open-source apps without a paid code-signing certificate. This is normal — click 'More info' then 'Run anyway' to proceed safely.",
  },
  {
    q: "Which reciters are available?",
    a: "Quran Studio ships with several renowned reciters in high quality audio, each with precise verse-by-verse timings for perfect sync.",
  },
  {
    q: "Can I add Urdu translation to my videos?",
    a: "Yes. Enable the Urdu translation toggle and it appears under each verse automatically.",
  },
  {
    q: "What format are exported videos?",
    a: "HD MP4 files, rendered locally on your machine — ready to upload to YouTube, TikTok, Instagram or share on WhatsApp.",
  },
  {
    q: "Does it work offline?",
    a: "The app itself runs locally. An internet connection is needed the first time to fetch reciter audio, Quran text and updates.",
  },
  {
    q: "Is there a web version?",
    a: "Yes — a browser version is available for quick edits without installing anything. The desktop app is recommended for full HD exports.",
  },
  {
    q: "How do I report a bug or request a feature?",
    a: "Open an issue on the GitHub repository (DashingMZA/quran-studio). Bug reports and ideas are welcome.",
  },
  {
    q: "Can I use the videos commercially?",
    a: "Videos you create are yours. The app is GPL-3.0 open source — check the license for redistribution terms of the software itself.",
  },
];
---

<Layout
  {...seo({
    title: "FAQ — Quran Studio",
    description:
      "Frequently asked questions about Quran Studio: pricing, Windows support, reciters, exports, offline use and more.",
    path: "/faq",
  })}
>
  <Nav />
  <main>
    <section class="section">
      <div class="container">
        <h1 class="section-title">Frequently Asked Questions</h1>
        <p class="section-sub">Quick answers to common questions.</p>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <div style="text-align: center; margin-top: 3rem">
          <p class="section-sub">Still stuck?</p>
          <a href="/contact" class="btn btn-ghost">Contact Us</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
