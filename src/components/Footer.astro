---
import {
  SITE_URL,
  SITE_NAME,
  SITE_BIOINFO,
  SITE_DOMAIN,
  AUTHOR_NAME,
  AUTHOR_GITHUB,
  GITHUB_REPO,
  GITHUB_RELEASES,
  GITHUB_LICENSE,
  SOCIALS,
} from "../config/site";
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="logo" aria-label="Quran Studio home">
        <img
          src="/icons/quran-studio-logo.svg"
          alt=""
          width="42"
          height="42"
          class="logo-icon"
          aria-hidden="true"
          loading="lazy"
        />
        <span class="logo-text"
          ><span class="brand-quran">Quran</span>
          <span class="brand-studio">Studio</span></span
        >
      </a>
      <p>
        {SITE_BIOINFO}
      </p>
    </div>
    <div class="footer-links">
      <a href="/features">Features</a>
      <a href="/how-it-works">How It Works</a>
      <a href="/download">Download</a>
      <a href="/faq">FAQ</a>
      <a href="/about">About</a>
    </div>
    <div class="footer-links">
      <a href="/contact">Contact</a>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms-of-use">Terms of Use</a>
      <a href="/disclaimer">Disclaimer</a>
      <a href="/sitemap">Sitemap</a>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="copyright">Made with ❤︎ in Pakistan. Developed by <a href={AUTHOR_GITHUB} target="_blank" rel="noopener">{AUTHOR_NAME}</a> - © 2026 <a href={SITE_URL} target="_blank" rel="noopener">{SITE_DOMAIN}</a>. All rights reserved.
      </p>
      <div class="social-icons">
        {
          SOCIALS.filter((s) => s.url).map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener"
              aria-label={s.name}
              title={s.name}
            >
              <img
                src={s.icon}
                alt={s.name}
                width="20"
                height="20"
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
