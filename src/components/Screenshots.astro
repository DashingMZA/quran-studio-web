---
// WebP versions (~90% smaller than the PNG originals). The main image is
// eager with explicit dimensions + aspect-ratio CSS (no layout shift when
// it arrives) and a 640w variant so phones don't download the 1280w file
// (PSI "Improve image delivery" was flagging the 1280w file at 362px wide).
const shots = [
  {
    src: "/screenshots/app-editor.webp",
    src640: "/screenshots/app-editor-640.webp",
    thumb: "/screenshots/app-editor-thumb.webp",
    alt: "Quran Studio editor",
    title: "Editor",
    text: "Pick verses, choose a reciter, style everything live.",
  },
  {
    src: "/screenshots/app-about.webp",
    src640: "/screenshots/app-about-640.webp",
    thumb: "/screenshots/app-about-thumb.webp",
    alt: "About dialog",
    title: "About",
    text: "Version info, updates and links — one click away.",
  },
  {
    src: "/screenshots/app-settings.webp",
    src640: "/screenshots/app-settings-640.webp",
    thumb: "/screenshots/app-settings-thumb.webp",
    alt: "Download settings",
    title: "Export Settings",
    text: "MP4 (H.264), High 1080p, AAC audio — configured once.",
  },
  {
    src: "/screenshots/app-full.webp",
    src640: "/screenshots/app-full-640.webp",
    thumb: "/screenshots/app-full-thumb.webp",
    alt: "Quran Studio full editor",
    title: "Full View",
    text: "Selection, preview and styling in one window.",
  },
];
---

<section class="section shots-section">
  <div class="container">
    <p class="kicker">Take a tour</p>
    <h2 class="section-title">See the app in action</h2>
    <p class="section-sub">A look inside Quran Studio — click through or sit back and watch.</p>
    <div class="shots-carousel" id="qs-shots">
      <div class="shots-main">
        <img
          src={shots[0].src}
          srcset={shots[0].src640 + " 640w, " + shots[0].src + " 1280w"}
          sizes="(max-width: 640px) 640px, 1280px"
          alt={shots[0].alt}
          id="qs-shot-img"
          width="1280"
          height="720"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="shots-caption">
          <strong id="qs-shot-title">{shots[0].title}</strong>
          <span id="qs-shot-text">{shots[0].text}</span>
        </div>
      </div>
      <div class="shots-thumbs" aria-label="App screenshots">
        {shots.map((s, i) => (
          <button
            class={"shot-thumb" + (i === 0 ? " active" : "")}
            data-idx={i}
            type="button"
            aria-pressed={i === 0 ? "true" : "false"}
            aria-label={"Show " + s.title + " screenshot"}
          >
            <img src={s.thumb} alt={s.alt} width="64" height="40" loading="lazy" decoding="async" />
            <span>{s.title}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ shots }}>
  (function () {
    var root = document.getElementById("qs-shots");
    if (!root) return;
    var img = document.getElementById("qs-shot-img");
    var titleEl = document.getElementById("qs-shot-title");
    var textEl = document.getElementById("qs-shot-text");
    var thumbs = Array.prototype.slice.call(
      root.querySelectorAll(".shot-thumb")
    );
    var idx = 0;
    var timer = null;
    var DELAY = 4000;

    function show(i) {
      idx = (i + shots.length) % shots.length;
      var s = shots[idx];
      img.style.opacity = "0";
      setTimeout(function () {
        img.src = s.src;
        img.srcset = s.src640 + " 640w, " + s.src + " 1280w";
        img.alt = s.alt;
        titleEl.textContent = s.title;
        textEl.textContent = s.text;
        img.style.opacity = "1";
      }, 180);
      thumbs.forEach(function (t, j) {
        t.classList.toggle("active", j === idx);
        t.setAttribute("aria-pressed", j === idx ? "true" : "false");
      });
    }

    function next() {
      show(idx + 1);
    }
    function restart() {
      stop();
      timer = setInterval(next, DELAY);
    }
    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    thumbs.forEach(function (t) {
      t.addEventListener("click", function () {
        show(parseInt(t.getAttribute("data-idx"), 10));
        restart();
      });
    });

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", restart);

    restart();
  })();
</script>
