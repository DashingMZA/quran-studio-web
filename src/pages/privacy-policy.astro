---
import { SITE_NAME, GITHUB_REPO } from "../config/site";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { seo } from "../lib/seo";
---

<Layout
  {...seo({
    title: "Privacy Policy — " + SITE_NAME + " | No Data Collected",
    description: "Privacy policy for — " + SITE_NAME + " and this website: what data is (and isn't) collected.",
    path: "/privacy-policy",
  })}
>
  <Nav />
  <main>
    <section class="section">
      <div class="container prose">
        <h1 class="section-title">Privacy Policy</h1>
        <p class="section-sub">Last updated: October 2026</p>
        <div class="prose-body">
          <h2>The Short Version</h2>
          <p><strong>{SITE_NAME}</strong> collects <strong>no personal data</strong>. The app runs locally on your machine. This website uses Google Analytics <strong>only if you accept cookies</strong> in the consent banner — decline it and nothing is tracked.</p>
          <h2>{SITE_NAME} App</h2>
          <ul>
            <li>No accounts, no sign-ups, no telemetry.</li>
            <li>Your projects and settings stay on your device.</li>
            <li>The app fetches public content (Quran text, reciter audio, backgrounds) from third-party APIs — those services see standard web requests, nothing tied to your identity.</li>
            <li>The auto-updater checks GitHub Releases for new versions.</li>
          </ul>
          <h2>This Website</h2>
          <ul>
            <li>Static pages — no server-side processing of visitor data.</li>
            <li><strong>Cookies &amp; analytics:</strong> we use Google Analytics 4 to understand aggregate usage (pages visited, country, device type). It loads <em>only</em> after you click "Accept" in the cookie banner; your choice is stored locally on your device ("qs-consent") and can be changed by clearing site data. No advertising cookies are used.</li>
            <li><strong>Advertising:</strong> we may show ads (e.g. Google AdSense) in the future. Ad providers may use cookies to serve relevant ads; their use is governed by their own privacy policies.</li>
            <li>Outbound links (GitHub, Ko-fi, etc.) are governed by those sites' own privacy policies.</li>
          </ul>
          <h2>Contact</h2>
          <p>Privacy questions: open an issue on the <a href={GITHUB_REPO} target="_blank" rel="noopener">GitHub repository</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
