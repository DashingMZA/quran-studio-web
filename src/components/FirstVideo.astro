---
const days = [
  {
    d: "Minute 1",
    title: "Download & open",
    text: "Install the app on Windows and launch it. No account, no sign-up.",
  },
  {
    d: "Minute 2",
    title: "Pick a surah",
    text: "Choose any surah and verse range — try Ayat-ul-Kursi for your first video.",
  },
  {
    d: "Minute 5",
    title: "Style it",
    text: "Pick a reciter, a font and a background. Watch the preview update live.",
  },
  {
    d: "Minute 10",
    title: "Export & upload",
    text: "Render your HD video and share it on YouTube, TikTok or WhatsApp.",
  },
];
---

<section class="section first">
  <div class="container">
    <p class="kicker">Your first video</p>
    <h2 class="section-title">From download to your first upload in 10 minutes</h2>
    <div class="timeline">
      {days.map((s) => (
        <div class="t-item">
          <div class="t-day">{s.d}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .first {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .kicker {
    text-align: center;
    color: var(--green);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .timeline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .t-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.5rem;
    position: relative;
  }
  .t-day {
    display: inline-block;
    background: var(--green-glow);
    border: 1px solid var(--green-dark);
    color: var(--green);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .t-item h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .t-item p {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
</style>
