{
    "$schema":"https://openapi.vercel.sh/vercel.json",
    "buildCommand":"pnpm build",
    "framework":"astro",
    "headers":[{
        "headers":[
            {"key":"X-Content-Type-Options","value":"nosniff"},
            {"key":"X-Frame-Options","value":"DENY"},
            {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
            {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=()"},
            {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.github.com https://www.google-analytics.com https://region1.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}],"source":"/(.*)"},
        {"headers":[
            {"key":"Cache-Control","value":"public, max-age=86400, immutable"}],"source":"/_astro/(.*)"},
        {"headers":[
            {"key":"Cache-Control","value":"public, max-age=86400, immutable"}],"source":"/icons/(.*)"}],
    "installCommand":"pnpm install",
    "outputDirectory":"dist",
    "redirects":[{
        "destination":"https://quranstudio.bond/:path*","has":[{"type":"host","value":"quran-studio-web.vercel.app"}],
        "permanent":true,
        "source":"/:path*"},
        {"destination":"https://quranstudio.bond/:path*",
        "has":[{"type":"host","value":"quran-studio-web-git-main-zaheer-ahmads-projects-ef063ece.vercel.app"}],
    "permanent":true,
    "source":"/:path*"}]}