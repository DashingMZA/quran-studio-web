---
import { SITE_NAME } from "../config/site";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { seo } from "../lib/seo";

const pages = [
  { url: "/", label: "Home" },
  { url: "/features", label: "Features" },
  { url: "/how-it-works", label: "How It Works" },
  { url: "/download", label: "Download" },
  { url: "/faq", label: "FAQ" },
  { url: "/about", label: "About" },
  { url: "/contact", label: "Contact" },
  { url: "/privacy-policy", label: "Privacy Policy" },
  { url: "/terms-of-use", label: "Terms of Use" },
  { url: "/disclaimer", label: "Disclaimer" },
];
---

<Layout
  {...seo({
    title: "Sitemap — " + SITE_NAME,
    description: "Browse every page on the " + SITE_NAME + " website.",
    path: "/sitemap",
  })}
>
  <Nav />
  <main>
    <section class="section">
      <div class="container prose">
        <h1 class="section-title">Sitemap</h1>
        <p class="section-sub">Every page on this site, in one place.</p>
        <div class="prose-body">
          <ul>
            {
              pages.map((p) => (
                <li>
                  <a href={p.url}>{p.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
