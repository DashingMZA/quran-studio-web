---
import { SITE_NAME } from "../config/site";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FirstVideo from "../components/FirstVideo.astro";
import Screenshots from "../components/Screenshots.astro";
import Footer from "../components/Footer.astro";
import { seo } from "../lib/seo";
---

<Layout
  {...seo({
    title: "How It Works — From Verses to Video in 4 Steps | " + SITE_NAME,
    description:
      "From verses to video in four steps: pick your verses, choose a reciter, style it your way, export and share. Your first video in 10 minutes.",
    path: "/how-it-works",
  })}
>
  <Nav />
  <main>
    <h1 class="sr-only">How It Works — From Verses to Video in 4 Steps</h1>
    <HowItWorks />
    <FirstVideo />
    <Screenshots />
    <section class="section">
      <div class="container" style="text-align: center">
        <h2 class="section-title">Ready to try it?</h2>
        <p class="section-sub">Free forever. No account, no watermark.</p>
        <a href="/download" class="btn btn-primary">Download {SITE_NAME}</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
