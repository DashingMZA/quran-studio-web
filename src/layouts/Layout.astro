---
import { GA_ID, SITE_VERIFICATION, SITE_URL } from "../config/site";

interface Props {
  title: string;
  description: string;
  themeColor: string;
  canonicalUrl: string;
  canonicalUrlen: string;
  canonicalUrlur: string;
  canonicalUrldefault: string;
  ogtitle: string;
  ogdescription: string;
  ogurl: string;
  ogsitename: string;
  oglocale: string;
  ogtype: string;
  ogupdatedtime: string;
  ogimage: string;
  ogimagealt: string;
  ogimagetype: string;
  ogimagewidth: string;
  ogimageheight: string;
  oglocalealternate: string;
  twittercard: string;
  twittertitle: string;
  twitterdescription: string;
  twitterimage: string;
  twitterimagealt: string;
}

const { title, description, themeColor, canonicalUrl, canonicalUrlen, canonicalUrlur, canonicalUrldefault, ogtitle, ogdescription, ogurl, ogsitename, oglocale, ogtype, ogupdatedtime, ogimage, ogimagealt, ogimagetype, ogimagewidth, ogimageheight, oglocalealternate, twittercard, twittertitle, twitterdescription, twitterimage, twitterimagealt } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"/>
    <meta name="theme-color" content={themeColor} />


    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrlen} />
    <link rel="alternate" hreflang="ur" href={canonicalUrlur} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrldefault} />

    <meta property="og:title" content={ogtitle} />
    <meta property="og:description" content={ogdescription} />
    <meta property="og:url" content={ogurl} />
    <meta property="og:site_name" content={ogsitename} />
    <meta property="og:locale" content={oglocale} />
    <meta property="og:type" content={ogtype} />
    <meta property="og:updated_time" content={ogupdatedtime} />

    <meta property="og:image" content={ogimage} />
    <meta property="og:image:alt" content={ogimagealt} />
    <meta property="og:image:type" content={ogimagetype} />
    <meta property="og:image:width" content={ogimagewidth} />
    <meta property="og:image:height" content={ogimageheight} />
    <meta property="og:locale:alternate" content={oglocalealternate} />

    <meta name="twitter:card" content={twittercard} />
    <meta name="twitter:title" content={twittertitle} />
    <meta name="twitter:description" content={twitterdescription} />
    <meta name="twitter:image" content={twitterimage} />
    <meta name="twitter:image:alt" content={twitterimagealt} />

    {/* Webmaster-tools verification (codes live in src/config/site.ts) */}
    {SITE_VERIFICATION.google && <meta name="google-site-verification" content={SITE_VERIFICATION.google} />}
    {SITE_VERIFICATION.bing && <meta name="msvalidate.01" content={SITE_VERIFICATION.bing} />}
    {SITE_VERIFICATION.pinterest && <meta name="p:domain_verify" content={SITE_VERIFICATION.pinterest} />}
    {SITE_VERIFICATION.yandex && <meta name="yandex-verification" content={SITE_VERIFICATION.yandex} />}

    {/* RSS feed for readers & AI agents */}
    <link rel="alternate" type="application/rss+xml" title={`${SITE_URL} — RSS`} href={`${SITE_URL}/rss.xml`} />

    {/* Google Analytics 4 (ID lives in src/config/site.ts — paste GA_ID to enable) */}
    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}

    <link rel="icon" type="image/svg+xml" href="icons/favicon.svg" />
    <link rel="icon" type="image/png" href="/icons/favicon-96x96.png" sizes="96x96"/>
    <link rel="icon" type="image/png" href="/icons/web-app-manifest-192x192.png" sizes="192x192"/>
    <link rel="icon" href="icons/favicon.ico" sizes="48x48"/>
    <link rel="apple-touch-icon" type="image/png" href="/icons/apple-touch-icon.png" sizes="180x180"/>

    <link rel="manifest" href="/icons/site.webmanifest" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>