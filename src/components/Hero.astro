---
import { APP_URL, GITHUB_REPO } from "../config/site";

// GitHub Releases API — hero version badge auto-updates on every new release.
// The hardcoded v1.0.1 below is only a fallback if the API is unreachable.
const RELEASE_API = GITHUB_REPO.replace("github.com", "api.github.com/repos") + "/releases/latest";
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="version-badge" data-release-api={RELEASE_API}>
      <span class="dot"></span>
      <span class="version-text">v1.0.1</span>
      <span class="version-sep">|</span>
      <span class="version-date">October 2026</span>
    </div>
    <h1 class="hero-title">
      <span class="brand-quran">Quran</span> <span class="brand-studio">Studio</span>
    </h1>
    <p class="hero-tag">
      Create beautiful Quran recitation videos in minutes.<br />
      Pick a reciter, style the verses, export in HD — free forever.
    </p>
    <div class="hero-cta">
      <a href="/download" class="btn btn-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <span data-os-label>Download for Windows</span>
      </a>
      <a
        href={APP_URL}
        target="_blank"
        rel="noopener"
        class="btn btn-ghost"
      >
        🌐 Open Web App
      </a>
    </div>
    <p class="hero-note">Open source &amp; free forever &bull; No account needed</p>
  </div>
</section>

<script>
  // Auto-update the hero version badge from the latest GitHub release,
  // and adapt the download button to the visitor's OS.
  (function () {
    var badge = document.querySelector("[data-release-api]");
    if (badge) {
      var text = badge.querySelector(".version-text");
      var dateEl = badge.querySelector(".version-date");
      fetch(badge.getAttribute("data-release-api"))
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (rel) {
          if (!rel || !rel.tag_name) return;
          if (text) text.textContent = rel.tag_name;
          if (dateEl && rel.published_at) {
            var d = new Date(rel.published_at);
            var months = ["January","February","March","April","May","June",
              "July","August","September","October","November","December"];
            dateEl.textContent = months[d.getMonth()] + " " + d.getFullYear();
          }
        })
        .catch(function () { /* keep hardcoded fallback */ });
    }

    var ua = navigator.userAgent;
    var os = /Windows/i.test(ua) ? "Windows"
      : /Macintosh|Mac OS X/i.test(ua) ? "macOS"
      : /Linux/i.test(ua) ? "Linux" : "Windows";
    var label = document.querySelector("[data-os-label]");
    if (label) label.textContent = "Download for " + os;
  })();
</script>
