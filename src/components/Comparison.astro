---
import {SITE_NAME} from "../config/site";
---
<section class="section">
  <div class="container">
    <p class="kicker">Why bother</p>
    <h2 class="section-title">Hours of editing, done before your tea gets cold</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>The job</th>
            <th>By hand</th>
            <th>With {SITE_NAME}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Sync verses with recitation audio</td>
            <td class="bad">✕ Hours of manual timing</td>
            <td class="good">✓ Automatic, word-perfect</td>
          </tr>
          <tr>
            <td>Style Arabic text beautifully</td>
            <td class="bad">✕ Fiddle with fonts &amp; colors</td>
            <td class="good">✓ Live preview, one click</td>
          </tr>
          <tr>
            <td>Add Urdu translation</td>
            <td class="bad">✕ Copy-paste verse by verse</td>
            <td class="good">✓ Built in, toggle on/off</td>
          </tr>
          <tr>
            <td>Make a background that fits</td>
            <td class="bad">✕ Search stock sites</td>
            <td class="good">✓ Curated gallery included</td>
          </tr>
          <tr>
            <td>Export for YouTube / TikTok</td>
            <td class="bad">✕ Render settings maze</td>
            <td class="good">✓ One-click HD MP4</td>
          </tr>
          <tr>
            <td>Cost</td>
            <td class="bad">✕ Pricey editors &amp; plugins</td>
            <td class="good">✓ Free &amp; open source</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>