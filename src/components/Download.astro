---
import DownloadWidget from "./DownloadWidget.astro";
---

<section id="download" class="section download">
  <div class="container">
    <h2 class="section-title">Start Creating Today</h2>
    <p class="section-sub">
      Download Quran Studio for your platform.<br />
      Open source and free forever.
    </p>

    <DownloadWidget />

    <p class="dl-meta" style="margin-top: 1.5rem">
      Free &bull; Open source (GPL-3.0) &bull; No account needed
    </p>

    <div class="note" style="margin-top: 2rem">
      <h4>⚠️ Installation Note</h4>
      <p>
        Since this is a new open-source application, Windows SmartScreen may
        flag it as unrecognized. This is normal for software without a paid
        certificate. You can safely click <strong>"More info"</strong> and
        <strong>"Run anyway"</strong> to proceed.
      </p>
    </div>
  </div>
</section>
